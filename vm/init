#!/bin/busybox sh
# The VM's whole userland: mount what the game needs, load the display and keyboard drivers,
# run the game on the first virtual console, then power off. Kernel arguments after "--" reach
# this script as its own and go to the game.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
# the archive holds no device nodes, so the console opens only now
exec > /dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
# in the order modules.dep gives; the kernel builds virtio-pci and the console in
for m in drm drm_kms_helper drm_shmem_helper virtio_dma_buf virtio-gpu virtio_input; do
  insmod "/lib/modules/$m.ko" || echo "init: $m did not load"
done
i=0
while [ ! -e /dev/fb0 ] && [ $i -lt 100 ]; do
  sleep 0.1
  i=$((i + 1))
done
# the best score file lands in the working directory, which lives in RAM
mkdir -p /play
cd /play
/flappy "$@" < /dev/tty1 > /dev/tty1 2> /dev/console
echo "init: the game ended with status $?" > /dev/console
poweroff -f
